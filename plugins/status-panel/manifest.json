{
  "manifestVersion": 1,
  "id": "dev.tsukiro.status",
  "name": "状态面板",
  "version": "1.0.0",
  "description": "显示 AI 当前心情与对用户的看法，支持 AI 打招呼并记住这次互动。",
  "author": {
    "name": "Tsukiro",
    "url": "https://github.com/tsukiro-chat"
  },
  "license": "MIT",
  "keywords": ["demo", "ui", "status"],
  "minHostVersion": "0.1.0",
  "hostApi": "^1.0.0",

  "runtime": {
    "main": "index.js",
    "type": "module",
    "autoStart": true
  },

  "permissions": [
    { "name": "sys.time", "reason": "点「现在几点」时读取系统时间" },
    { "name": "ui", "reason": "显示状态与 AI 打招呼结果" },
    { "name": "agent.state.read", "reason": "显示当前 AI 心情与对用户看法" },
    { "name": "agent.state.write", "reason": "更新心情并执行 AI 打招呼" },
    { "name": "memory.write", "reason": "让 AI 记住这次打招呼" }
  ],

  "provides": {
    "tools": [
      {
        "name": "check_time",
        "description": "获取当前时间。当用户询问现在几点、今天几号时调用。",
        "parameters": {
          "type": "object",
          "properties": {
            "timezone": {
              "type": "string",
              "description": "IANA 时区名，如 Asia/Shanghai。留空表示使用设备本地时区。"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "handler": "handlers/check_time.js",
        "permissions": ["sys.time"],
        "timeoutMs": 5000,
        "returns": "object"
      }
    ],

    "ui": [
      {
        "slot": "chat.toolbar",
        "id": "time-now",
        "type": "button",
        "label": "现在几点",
        "icon": "lucide:clock",
        "tooltip": "让插件读一次系统时间",
        "order": 20,
        "when": {
          "hasMessages": true
        },
        "onClick": {
          "event": "status.time_clicked"
        },
        "permissions": ["sys.time"]
      },
      {
        "slot": "agent.actions",
        "id": "greet",
        "type": "button",
        "label": "打招呼",
        "icon": "lucide:smile",
        "tooltip": "打个招呼",
        "order": 10,
        "onClick": {
          "event": "status.greet"
        },
        "permissions": ["ui"]
      },
      {
        "slot": "agent.sections",
        "id": "panel",
        "type": "section",
        "label": "状态面板",
        "icon": "lucide:activity",
        "order": 50,
        "children": [
          {
            "slot": "agent.sections",
            "id": "mood",
            "type": "text",
            "label": "AI 心情",
            "binding": "agent.mood.label",
            "permissions": ["agent.state.read"]
          },
          {
            "slot": "agent.sections",
            "id": "opinion",
            "type": "text",
            "label": "对你的看法",
            "binding": "agent.opinion",
            "permissions": ["agent.state.read"]
          },
          {
            "slot": "agent.sections",
            "id": "hint",
            "type": "text",
            "label": "状态由插件保存，打招呼不会写入普通对话记录。"
          },
          {
            "slot": "agent.sections",
            "id": "auto",
            "type": "toggle",
            "label": "自动报时",
            "icon": "lucide:timer",
            "permissions": ["ui"]
          },
          {
            "slot": "agent.sections",
            "id": "ping",
            "type": "button",
            "label": "报时",
            "icon": "lucide:zap",
            "order": 1,
            "onClick": {
              "event": "status.time_clicked"
            },
            "permissions": ["sys.time"]
          }
        ]
      }
    ]
  }
}
