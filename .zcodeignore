# ── 工具链不在仓库内（装在 C:\dev\），但防御性忽略 ──
tools/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
dist/

# ── 下载缓存 ──
.tmp/
*.zip
!plugins/**/*.zip

# ── Dart 的家目录（重定向进仓库，见 scripts/dart.ps1） ──
.dart/

# ── 依赖 ──
node_modules/
# 注意：pubspec.lock 故意不忽略。
# plugin_core 是 publish_to: none 的包（非发布库），锁定依赖版本才能保证
# 每个人的构建与 CI 拿到完全一致的依赖 —— 对安全相关的内核尤其重要。

# ── IDE ──
.idea/
.vscode/
*.iml
*.swp

# ── 测试产物 ──
coverage/
*.lcov
test/.tmp/

# ── 系统 ──
Thumbs.db
Desktop.ini
.DS_Store

# ── 凭据：绝不入库 ──
.env
.env.*
*.key
*.pem
secrets/

# 本地开发配置（含真实 API Key）。模板 dev-config.example.json 是提交的。
# 注意：一旦某个含密钥的文件被提交过，删掉它并不能从 git 历史里移除 ——
# 只能轮换密钥。见 dev/README.md。
dev/dev-config.json
dev/*.local.json

# ── Flutter 宿主 App 的构建产物 ──
# （build/ 已在上面统一忽略；这里补 Flutter 特有的一堆）
packages/host_app/.dart_tool/
packages/host_app/android/.gradle/
packages/host_app/android/local.properties
packages/host_app/android/app/debug/
packages/host_app/android/app/profile/
packages/host_app/android/app/release/
*.iml
# ── Host App 里的真实凭据（模板 example 是提交的） ──
packages/host_app/assets/dev-config.json
# ── 演示插件（由 scripts/sync_demo_plugins.mjs 从 plugins/ 复制） ──
# 单一事实来源是仓库根的 plugins/，这里那份是构建产物
packages/host_app/assets/demo_plugins/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
